# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
# One log line per request. Set to false to hide them.
LOG_REQUESTS=true

# --- MySQL (menu, categories, orders) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=coffee_shop
# Cloud providers such as Aiven require TLS: paste their CA certificate here (keep the quotes).
MYSQL_SSL_CA=""

# --- MongoDB (reviews, contact messages) ---
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=coffee_shop
