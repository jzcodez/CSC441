{
  "name": "coffee-website-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API and static file server for the Ember & Bean coffee website",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:mysql": "node scripts/setup-mysql.js",
    "db:mongo": "node scripts/seed-mongo.js",
    "db:setup": "npm run db:mysql && npm run db:mongo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6"
  }
}
